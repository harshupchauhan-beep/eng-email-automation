generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  ARCHIVED
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  QUEUING
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  REJECTED
  FAILED
  SUPPRESSED
  CANCELLED
  SKIPPED
}

enum FailureCategory {
  TRANSIENT
  PERMANENT
  SUPPRESSED
  PROVIDER_REJECTED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AudienceType {
  ALL
  TAGS
  SEGMENT
  MANUAL
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(OPERATOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  sessions     Session[]
  auditLogs    AuditLog[]
  campaigns    Campaign[] @relation("CampaignCreatedBy")
  importJobs   ImportJob[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model Contact {
  id              String        @id @default(uuid())
  email           String
  emailNormalized String        @unique
  firstName       String?
  lastName        String?
  company         String?
  phone           String?
  status          ContactStatus @default(ACTIVE)
  source          String?
  customFields    Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?
  tags            ContactTag[]
  recipients      CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@index([company])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model Segment {
  id          String     @id @default(uuid())
  name        String
  description String?
  filter      Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model Template {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         TemplateVersion[]
  currentVersionId String?           @unique
  currentVersion   TemplateVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  campaigns        Campaign[]
}

model TemplateVersion {
  id          String     @id @default(uuid())
  templateId  String
  template    Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  currentFor  Template?  @relation("CurrentVersion")
  version     Int
  subject     String
  preheader   String?
  htmlBody    String
  textBody    String
  fallbacks   Json       @default("{}")
  createdAt   DateTime   @default(now())
  createdById String?

  @@unique([templateId, version])
}

model Campaign {
  id                        String         @id @default(uuid())
  name                      String
  fromName                  String
  fromEmail                 String
  replyTo                   String?
  subject                   String
  preheader                 String?
  templateId                String?
  template                  Template?      @relation(fields: [templateId], references: [id])
  templateVersionId         String?
  audienceType              AudienceType   @default(ALL)
  audienceConfig            Json           @default("{}")
  segmentId                 String?
  segment                   Segment?       @relation(fields: [segmentId], references: [id])
  status                    CampaignStatus @default(DRAFT)
  scheduledAt               DateTime?
  sendNow                   Boolean        @default(true)
  cancellationWindowSeconds Int            @default(15)
  createdById               String
  createdBy                 User           @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  send                      CampaignSend?
  statsQueued               Int            @default(0)
  statsProcessing           Int            @default(0)
  statsSent                 Int            @default(0)
  statsDelivered            Int            @default(0)
  statsFailed               Int            @default(0)
  statsBounced              Int            @default(0)
  statsComplained           Int            @default(0)
  statsUnsubscribed         Int            @default(0)
  statsSuppressed           Int            @default(0)
  statsEligible             Int            @default(0)
  statsInvalid              Int            @default(0)
  statsSelected             Int            @default(0)

  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
}

model CampaignSend {
  id                  String              @id @default(uuid())
  campaignId          String              @unique
  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  idempotencyKey      String              @unique
  status              CampaignStatus
  fromName            String
  fromEmail           String
  replyTo             String?
  subjectTemplate     String
  preheaderTemplate   String?
  htmlTemplate        String
  textTemplate        String
  fallbacks           Json                @default("{}")
  physicalAddress     String?
  companyName         String?
  audienceSnapshot    Json
  eligibleCount       Int                 @default(0)
  suppressedCount     Int                 @default(0)
  invalidCount        Int                 @default(0)
  queuedAt            DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  cancelledAt         DateTime?
  cancelAfter         DateTime?
  createdAt           DateTime            @default(now())
  recipients          CampaignRecipient[]

  @@index([status])
}

model CampaignRecipient {
  id                String            @id @default(uuid())
  campaignSendId    String
  campaignSend      CampaignSend      @relation(fields: [campaignSendId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email             String
  emailNormalized   String
  personalization   Json
  status            DeliveryStatus    @default(PENDING)
  failureCategory   FailureCategory?
  failureReason     String?
  attemptCount      Int               @default(0)
  idempotencyKey    String            @unique
  queuedAt          DateTime?
  attemptedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  unsubscribedAt    DateTime?
  providerMessageId String?
  lastError         String?
  nextRetryAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deliveries        EmailDelivery[]
  events            EmailEvent[]

  @@unique([campaignSendId, emailNormalized])
  @@index([campaignSendId, status])
  @@index([status, nextRetryAt])
  @@index([providerMessageId])
  @@index([emailNormalized])
}

model EmailDelivery {
  id                  String            @id @default(uuid())
  campaignRecipientId String
  recipient           CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  attemptNumber       Int
  provider            String
  providerMessageId   String?
  status              DeliveryStatus
  failureCategory     FailureCategory?
  responseCode        Int?
  errorMessage        String?
  createdAt           DateTime          @default(now())

  @@unique([campaignRecipientId, attemptNumber])
  @@index([providerMessageId])
}

model EmailEvent {
  id                  String             @id @default(uuid())
  campaignRecipientId String?
  recipient           CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  provider            String
  providerEventId     String             @unique
  type                String
  emailNormalized     String
  payload             Json
  processedAt         DateTime           @default(now())

  @@index([emailNormalized, type])
  @@index([campaignRecipientId])
}

model Suppression {
  id              String             @id @default(uuid())
  emailNormalized String             @unique
  email           String
  reason          SuppressionReason
  source          String?
  notes           String?
  createdAt       DateTime           @default(now())
  createdById     String?

  @@index([createdAt])
}

model ImportJob {
  id           String          @id @default(uuid())
  filename     String
  filePath     String
  status       ImportJobStatus @default(PENDING)
  totalRows    Int             @default(0)
  imported     Int             @default(0)
  duplicates   Int             @default(0)
  invalid      Int             @default(0)
  suppressed   Int             @default(0)
  failed       Int             @default(0)
  errorMessage String?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WorkerHeartbeat {
  id          String   @id @default("primary")
  hostname    String
  pid         Int
  lastSeenAt  DateTime
  metadata    Json     @default("{}")
}
