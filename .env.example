# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC
LOG_LEVEL=info

# PostgreSQL (authoritative campaign state)
DATABASE_URL=postgresql://engmail:engmail@localhost:5432/engmail?schema=public&connect_timeout=3

# Redis (queues only — never the source of truth)
REDIS_URL=redis://localhost:6379

# Session and secrets (generate long random values; never commit real secrets)
SESSION_SECRET=replace-with-64-char-random-string
UNSUBSCRIBE_SECRET=replace-with-64-char-random-string
WEBHOOK_SECRET=replace-with-64-char-random-string

# Bootstrap admin (used only by prisma seed; no public registration)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator

# Email provider: fake | ses | sendgrid | mailgun | postmark
EMAIL_PROVIDER=fake
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Example Organization
EMAIL_REPLY_TO=

# Provider-specific (leave empty if unused)
SES_REGION=us-east-1
SES_CONFIGURATION_SET=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_TOKEN=

# Worker throughput — respect provider quotas, never bypass them
EMAIL_WORKER_CONCURRENCY=10
EMAIL_RATE_LIMIT_PER_SECOND=14
EMAIL_BATCH_SIZE=500
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_MS=2000
CAMPAIGN_CANCELLATION_WINDOW_SECONDS=15
RECONCILE_INTERVAL_MS=30000
STUCK_PROCESSING_MS=300000

# Organization identity (required for marketing mail)
ORG_NAME=Example Organization
ORG_PHYSICAL_ADDRESS=123 Example Street, City, Country
ORG_SUPPORT_EMAIL=support@example.com

# Optional tracking (opens/clicks are imperfect and have privacy implications)
ENABLE_OPEN_TRACKING=false
ENABLE_CLICK_TRACKING=false

# API rate limiting
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_15MIN=5

# Fake provider (development / load tests only)
FAKE_PROVIDER_LATENCY_MS=25
FAKE_PROVIDER_THROTTLE_RATE=0.02
FAKE_PROVIDER_TRANSIENT_RATE=0.03
FAKE_PROVIDER_PERMANENT_RATE=0.01

# Worker health
WORKER_HEALTH_PORT=3001
